<UserControl x:Class="TrameEditor.App.Views.AskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrameEditor.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DocumentQaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="White" BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
        <DockPanel Margin="10,8">
            <TextBlock DockPanel.Dock="Top" Text="💬 Chiedi al documento" FontWeight="Bold"
                       FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                        Visibility="{Binding Unavailable, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Impostazioni…" Padding="10,3" FontWeight="SemiBold"
                        Click="Settings_Click" />
                <Button Content="Riprova" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding RetryCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Invia" Padding="10,4" Margin="6,0,0,0"
                            FontWeight="Bold" Command="{Binding AskCommand}" />
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,4" TextWrapping="Wrap" MaxHeight="70"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Domanda per l'assistente"
                             IsEnabled="{Binding Ready}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="L'AI locale può sbagliare: verifica sempre sul documento. Nessun dato lascia il tuo computer." />
            </StackPanel>
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QaMessageViewModel}">
                            <Border Margin="0,3" Padding="8,6" CornerRadius="8" MaxWidth="290">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F2F2F0" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="#DCE8F8" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding SourcePages}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,4,0" Padding="5,1" FontSize="10"
                                                        Cursor="Hand" Click="Reference_Click"
                                                        ToolTip="Vai al punto citato">
                                                    <!-- TextBlock: su Button lo StringFormat del binding
                                                         non si applica a Content -->
                                                    <TextBlock>
                                                        <Run Text="{Binding DataContext.ReferenceLabel, Mode=OneWay,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        <Run Text="{Binding Mode=OneWay}" />
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
