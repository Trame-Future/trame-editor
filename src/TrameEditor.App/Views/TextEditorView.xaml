<UserControl x:Class="TrameEditor.App.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:TrameEditor.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBand}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsMarkdown, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource TbButton}" ToolTip="Grassetto" Click="Bold_Click">
                    <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8DD;" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Corsivo" Click="Italic_Click">
                    <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8DB;" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Codice inline" Click="Code_Click">
                    <TextBlock FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Text="&lt;/&gt;" />
                </Button>
                <Rectangle Style="{StaticResource TbSeparator}" />
                <Button Style="{StaticResource TbButton}" ToolTip="Titolo 1" Click="H1_Click">
                    <TextBlock FontWeight="Bold" FontSize="14" Text="H1" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Titolo 2" Click="H2_Click">
                    <TextBlock FontWeight="Bold" FontSize="12.5" Text="H2" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Titolo 3" Click="H3_Click">
                    <TextBlock FontWeight="Bold" FontSize="11.5" Text="H3" />
                </Button>
                <Rectangle Style="{StaticResource TbSeparator}" />
                <Button Style="{StaticResource TbButton}" ToolTip="Elenco puntato" Click="Bullet_Click">
                    <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8FD;" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Elenco numerato" Click="Numbered_Click">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="1." />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Citazione" Click="Quote_Click">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="❝" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Inserisci link" Click="Link_Click">
                    <TextBlock Style="{StaticResource TbIcon}" Text="&#xE71B;" />
                </Button>
                <Button Style="{StaticResource TbButton}" ToolTip="Inserisci tabella" Click="Table_Click">
                    <TextBlock FontSize="14" Text="⊞" />
                </Button>
                <Rectangle Style="{StaticResource TbSeparator}" />
                    <ToggleButton Style="{StaticResource TbToggle}" IsChecked="{Binding ShowPreview}"
                                  ToolTip="Mostra/nascondi l'anteprima affiancata">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE890;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Anteprima" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource TbSeparator}" />
                </StackPanel>
                <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.Name="Chiedi"
                              IsChecked="{Binding AskMode}"
                              ToolTip="Chiedi al documento: AI locale (Ollama), nessun dato lascia il computer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" VerticalAlignment="Center" Text="💬" />
                        <TextBlock Style="{StaticResource TbLabel}" Text="Chiedi" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <avalonedit:TextEditor x:Name="Editor"
                                   Document="{Binding EditorDocument}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="14"
                                   Padding="4,2"
                                   WordWrap="{Binding DataContext.WordWrap, RelativeSource={RelativeSource AncestorType=Window}}"
                                   ShowLineNumbers="{Binding DataContext.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=Window}}" />
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#EEEEEE" />
            <Border x:Name="PreviewHost" Grid.Column="2"
                    BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
                <wv2:WebView2 x:Name="Preview" />
            </Border>
            <views:AskPanel Grid.Column="3" Width="330" DataContext="{Binding Qa}"
                            Visibility="{Binding DataContext.AskMode, RelativeSource={RelativeSource AncestorType=UserControl},
                                         Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
