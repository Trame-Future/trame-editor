<UserControl x:Class="TrameEditor.App.Views.PdfViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrameEditor.App.ViewModels"
             xmlns:controls="clr-namespace:TrameEditor.App.Controls">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBand}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.Name="Modifica testo" IsChecked="{Binding EditMode}"
                                  ToolTip="Attiva la modifica del testo: clicca una riga sulla pagina">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE70F;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Modifica testo" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding AnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlight}" AutomationProperties.Name="Evidenzia"
                                  ToolTip="Evidenzia: clicca una riga di testo sulla pagina">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE7E6;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Evidenzia" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding AnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Note}" AutomationProperties.Name="Nota"
                                  ToolTip="Nota: clicca un punto della pagina e scrivi il testo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8BD;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Nota" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding AnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Stamp}" AutomationProperties.Name="Timbro"
                                  ToolTip="Timbro: scegli un'immagine (firma, logo) e clicca dove metterla">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE91B;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Timbro" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.Name="Chiedi" IsChecked="{Binding AskMode}"
                                  ToolTip="Chiedi al documento: AI locale (Ollama), nessun dato lascia il computer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="12" VerticalAlignment="Center" Text="💬" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Chiedi" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.Name="Modulo" IsChecked="{Binding FormMode}"
                                  ToolTip="Modulo: compila i campi del PDF (AcroForm)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE762;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Modulo" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource TbButton}" Command="{Binding RunOcrCommand}" AutomationProperties.Name="OCR"
                            ToolTip="Riconosce il testo delle pagine scansionate (OCR offline ita+eng)">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="OCR" />
                    </Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding CompressCommand}" AutomationProperties.Name="Comprimi"
                            ToolTip="Salva una copia compressa del PDF (ricomprime le immagini)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE73F;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Comprimi…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding RedactCommand}" AutomationProperties.Name="Anonimizza"
                            ToolTip="Trova e rimuove davvero i dati personali (CF, IBAN, email, telefoni, targhe) e i metadati">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Text="🛡" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Anonimizza…" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource TbSeparator}" />
                    <Button Style="{StaticResource TbButton}" ToolTip="Ruota a sinistra le pagine selezionate"
                            Command="{Binding RotateLeftCommand}">
                        <TextBlock FontSize="15" Text="⟲" />
                    </Button>
                    <Button Style="{StaticResource TbButton}" ToolTip="Ruota a destra le pagine selezionate"
                            Command="{Binding RotateRightCommand}">
                        <TextBlock FontSize="15" Text="⟳" />
                    </Button>
                    <Button Style="{StaticResource TbButton}" ToolTip="Elimina le pagine selezionate"
                            Command="{Binding DeleteSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE74D;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Elimina" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TbButton}" ToolTip="Sposta in su le pagine selezionate"
                            Command="{Binding MoveUpCommand}">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE74A;" />
                    </Button>
                    <Button Style="{StaticResource TbButton}" ToolTip="Sposta in giù le pagine selezionate"
                            Command="{Binding MoveDownCommand}">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE74B;" />
                    </Button>
                    <Button Style="{StaticResource TbButton}" ToolTip="Estrai le pagine selezionate in un nuovo PDF"
                            Command="{Binding ExtractSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8C8;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Estrai…" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource TbSeparator}" />
                    <Button Style="{StaticResource TbButton}" ToolTip="Riduci zoom" Command="{Binding ZoomOutCommand}">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE71F;" />
                    </Button>
                    <TextBlock Text="{Binding ZoomDisplay}" VerticalAlignment="Center"
                               MinWidth="42" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <Button Style="{StaticResource TbButton}" ToolTip="Aumenta zoom" Command="{Binding ZoomInCommand}">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE8A3;" />
                    </Button>
                    <Rectangle Style="{StaticResource TbSeparator}" />
                    <TextBox Width="170" Style="{StaticResource TbTextBox}"
                             ToolTip="Cerca nel testo del PDF (Invio per cercare)"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource TbButton}" ToolTip="Cerca nel testo del PDF"
                            Command="{Binding SearchCommand}">
                        <TextBlock Style="{StaticResource TbIcon}" Text="&#xE721;" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding SearchMatches.Count, Mode=OneWay}" /><Run Text=" risultati" />
                    </TextBlock>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="{Binding Pages.Count, Mode=OneWay}" /><Run Text=" pagine" />
                </TextBlock>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FFF6E0" BorderBrush="#E0C880" BorderThickness="0,1"
                Visibility="{Binding ActiveRegion, Converter={StaticResource NullToVisibility}}">
            <StackPanel Margin="10,7">
                <DockPanel>
                    <TextBlock Text="Nuovo testo:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Margin="4,0,0,0"
                            Command="{Binding CancelEditCommand}">
                        <TextBlock Text="Annulla" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TbButton}" Margin="10,0,0,0"
                            Command="{Binding ApplyEditCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TbIcon}" Text="&#xE73E;" />
                            <TextBlock Style="{StaticResource TbLabel}" Text="Applica" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <TextBox Style="{StaticResource TbTextBox}" FontSize="14"
                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyEditCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#8A6D3B"
                           Text="{Binding PlanDescription, StringFormat='Font che verrà usato: {0}'}" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Miniature: qui si selezionano le pagine per le operazioni -->
            <ListBox x:Name="ThumbList" ItemsSource="{Binding Pages}"
                     SelectionMode="Extended" SelectionChanged="ThumbList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ThumbList_PreviewMouseMove"
                     Drop="ThumbList_Drop"
                     Background="#F3F3F3" BorderThickness="0,0,1,0" BorderBrush="#DDDDDD">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PdfPageViewModel}">
                        <StackPanel Margin="4">
                            <Border Background="White" BorderBrush="#BBBBBB" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Image Source="{Binding Thumbnail}" MaxWidth="110"
                                       Loaded="Thumb_Loaded">
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding RotationDelta}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Border>
                            <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center"
                                       Foreground="#666666" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pagine -->
            <ListBox x:Name="PageList" Grid.Column="1" ItemsSource="{Binding Pages}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="{StaticResource CanvasBrush}" BorderThickness="0"
                     HorizontalContentAlignment="Center"
                     PreviewMouseWheel="PageList_PreviewMouseWheel"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PdfPageViewModel}">
                        <Border Margin="14,10" Background="White" HorizontalAlignment="Center"
                                BorderBrush="#C8C6C4" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding Image}" Loaded="Page_Loaded" Stretch="Uniform"
                                       MouseLeftButtonDown="PageImage_MouseDown">
                                    <Image.Width>
                                        <MultiBinding Converter="{StaticResource Multiply}">
                                            <Binding Path="BaseWidth" />
                                            <Binding Path="DataContext.Zoom"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Image.Width>
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding RotationDelta}" />
                                    </Image.LayoutTransform>
                                </Image>
                                <ItemsControl ItemsSource="{Binding EditRegions}"
                                              Visibility="{Binding DataContext.ShowRegions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PdfTextRegionViewModel}">
                                            <Border BorderThickness="1" CornerRadius="1" Cursor="Hand"
                                                    MouseLeftButtonDown="Region_MouseDown"
                                                    ToolTip="{Binding ToolTipText}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Height>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Border.Height>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#8032A0FF" />
                                                        <Setter Property="Background" Value="#1432A0FF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                                <Setter Property="BorderBrush" Value="#60999999" />
                                                                <Setter Property="Background" Value="#10999999" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Evidenziazione dei risultati di ricerca -->
                                <ItemsControl ItemsSource="{Binding SearchHighlights}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PdfTextRegionViewModel}">
                                            <Rectangle Fill="#55FFD400" Stroke="#AAE0A800" StrokeThickness="1">
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                                <Rectangle.Height>
                                                    <MultiBinding Converter="{StaticResource Multiply}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.Zoom"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Rectangle.Height>
                                            </Rectangle>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Risultati ricerca -->
            <ListBox Grid.Column="2" ItemsSource="{Binding SearchMatches}"
                     SelectedItem="{Binding SelectedMatch}"
                     SelectionChanged="Matches_SelectionChanged"
                     BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Width" Value="240" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchMatches.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PdfSearchMatch}">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pannello Modulo (AcroForm) -->
            <Border Grid.Column="3" Width="290" Background="White"
                    BorderThickness="1,0,0,0" BorderBrush="#DDDDDD"
                    Visibility="{Binding FormMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="Modulo PDF" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding FormStatus}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Padding="0,6" Margin="0,0,0,8"
                                Command="{Binding AutoFillFormCommand}" AutomationProperties.Name="Compila per me"
                                ToolTip="Riempie i campi con i tuoi dati salvati (cifrati sul PC)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="12" Text="⚡" />
                                <TextBlock Margin="5,0,0,0" Text="Compila per me" />
                            </StackPanel>
                        </Button>
                        <CheckBox Content="Appiattisci (blocca il modulo)" FontSize="12"
                                  IsChecked="{Binding FlattenOnApply}"
                                  ToolTip="I valori diventano contenuto fisso: il modulo non sarà più compilabile" />
                        <Button Margin="0,8,0,0" Padding="0,6" FontWeight="Bold"
                                Content="Applica al PDF" Command="{Binding ApplyFormCommand}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FormFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PdfFormFieldViewModel}">
                                    <StackPanel Margin="0,0,4,10">
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="3,2"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}" />
                                        <ComboBox ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Value}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Chiedi al documento (AI locale) -->
            <Border Grid.Column="4" Width="330" Background="White"
                    BorderThickness="1,0,0,0" BorderBrush="#DDDDDD"
                    Visibility="{Binding AskMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="10,8">
                    <TextBlock DockPanel.Dock="Top" Text="💬 Chiedi al documento" FontWeight="Bold"
                               FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding QaStatus}" TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                                Visibility="{Binding QaUnavailable, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Impostazioni AI…" Padding="10,3" FontWeight="SemiBold"
                                Click="QaSettings_Click" />
                        <Button Content="Riprova" Padding="10,3" Margin="6,0,0,0"
                                Command="{Binding RetryQaCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Invia" Padding="10,4" Margin="6,0,0,0"
                                    FontWeight="Bold" Command="{Binding AskCommand}" />
                            <TextBox Text="{Binding QaInput, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,4" TextWrapping="Wrap" MaxHeight="70"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding QaReady}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="L'AI locale può sbagliare: verifica sempre sul documento. Nessun dato lascia il tuo computer." />
                    </StackPanel>
                    <ScrollViewer x:Name="QaScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding QaMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QaMessageViewModel}">
                                    <Border Margin="0,3" Padding="8,6" CornerRadius="8" MaxWidth="290">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F2F2F0" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#DCE8F8" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                            <ItemsControl ItemsSource="{Binding SourcePages}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,4,0" Padding="5,1" FontSize="10"
                                                                Cursor="Hand" Click="QaSource_Click"
                                                                ToolTip="Vai alla pagina">
                                                            <!-- TextBlock: su Button lo StringFormat del binding
                                                                 non si applica a Content -->
                                                            <TextBlock Text="{Binding StringFormat='pag. {0}'}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Attesa: pianeta Trame Future in rotazione durante le operazioni lunghe -->
            <Border Grid.Column="0" Grid.ColumnSpan="5" Background="#B8FFFFFF"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:PlanetSpinner Width="170" />
                    <TextBlock Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Elaborazione in corso…" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
