<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette in stile Office: accento blu Word, grigi neutri -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2B579A" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1E3F73" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F2F1" />
    <SolidColorBrush x:Key="BandBrush" Color="#F9F8F7" />
    <SolidColorBrush x:Key="BandBorderBrush" Color="#E1DFDD" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E3EAF6" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#C9D8EE" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D0DCEF" />
    <SolidColorBrush x:Key="CheckedBrush" Color="#CFE0F5" />
    <SolidColorBrush x:Key="CheckedBorderBrush" Color="#9DBBE3" />
    <SolidColorBrush x:Key="TextBrush" Color="#323130" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#605E5C" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#E8E6E4" />

    <!-- Banda toolbar (sotto il menu, sopra il contenuto) -->
    <Style x:Key="ToolbarBand" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BandBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BandBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Icona (Segoe Fluent con fallback MDL2) ed etichetta dei pulsanti -->
    <Style x:Key="TbIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="TbLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Pulsante piatto da toolbar -->
    <Style x:Key="TbButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruttore piatto da toolbar (stato attivo evidenziato) -->
    <Style x:Key="TbToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CheckedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CheckedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separatore verticale da toolbar -->
    <Style x:Key="TbSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="#DADADA" />
        <Setter Property="Margin" Value="6,3" />
    </Style>

    <!-- Casella di testo da toolbar -->
    <Style x:Key="TbTextBox" TargetType="TextBox">
        <Setter Property="BorderBrush" Value="#C8C6C4" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Linguette dei documenti (stile Office) -->
    <Style x:Key="DocTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Panel.ZIndex="1" IsItemsHost="True" Margin="8,0,8,-1"
                                  Background="Transparent" />
                        <Border Grid.Row="1" Background="White"
                                BorderBrush="#D6D4D2" BorderThickness="0,1,0,0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DocTabItem" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="#EAE8E6"
                            BorderBrush="#D6D4D2" BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0" Padding="12,6" Margin="0,6,3,0">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsante di chiusura scheda -->
    <Style x:Key="TabCloseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                            Width="18" Height="18" Margin="8,0,0,0">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra di stato blu (come Word) -->
    <!-- Menu classico: la barra File / Modifica / Visualizza … sopra la barra multifunzione -->
    <Style x:Key="ClassicMenuBar" TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource BandBrush}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#E1DFDD" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="OfficeStatusBar" TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
</ResourceDictionary>
