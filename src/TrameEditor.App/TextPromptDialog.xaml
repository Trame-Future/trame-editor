<Window x:Class="TrameEditor.App.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nome"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Annulla" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
