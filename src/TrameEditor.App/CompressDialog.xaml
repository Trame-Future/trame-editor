<Window x:Class="TrameEditor.App.CompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprimi PDF"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="16,14">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Le immagini vengono ricompresse; il testo resta intatto. L'originale non viene toccato: il risultato va in una copia." />

        <RadioButton x:Name="BestChoice" IsChecked="True" Margin="0,4">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Comprimi al meglio" />
                <Run Text="— una passata sola, senza degradare troppo il documento." />
            </TextBlock>
        </RadioButton>

        <RadioButton x:Name="TargetChoice" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Deve stare sotto un certo peso" />
                <Run Text="— utile per gli allegati alla PEC. Si prova per gradi e ci si ferma appena rientra." />
            </TextBlock>
        </RadioButton>
        <DockPanel Margin="26,6,0,0" IsEnabled="{Binding IsChecked, ElementName=TargetChoice}">
            <TextBlock DockPanel.Dock="Left" Text="Massimo:" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBox x:Name="SizeBox" Text="10" Width="70" HorizontalAlignment="Left"
                     Margin="8,0,0,0" Padding="3,2" />
        </DockPanel>
        <TextBlock Margin="26,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Se nemmeno al massimo della compressione il file rientra, te lo diciamo invece di far finta di esserci riusciti." />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Annulla" Width="90" Padding="0,5"
                    Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Comprimi…" Width="110" Padding="0,5"
                    FontWeight="Bold" IsDefault="True" Click="Ok_Click" />
        </DockPanel>
    </StackPanel>
</Window>
