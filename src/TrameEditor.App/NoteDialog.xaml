<Window x:Class="TrameEditor.App.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova nota"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <StackPanel Margin="18,14">
        <TextBlock Text="Testo della nota:" Margin="0,0,0,6" />
        <TextBox x:Name="NoteText" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                 Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Annulla" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
