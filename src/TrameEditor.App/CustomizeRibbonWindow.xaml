<Window x:Class="TrameEditor.App.CustomizeRibbonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrameEditor.App"
        Title="Personalizza la barra multifunzione"
        Icon="Assets/icon-256.png"
        Width="1000" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinWidth" Value="112" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:LayoutNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Symbol}" Margin="0,0,6,0" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Text="  (grande)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Visibility="{Binding LargeHint}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A sinistra tutte le funzioni di TrameEditor, raggruppate come nei menu. A destra la barra multifunzione: schede, riquadri e pulsanti. Le funzioni che togli dalla barra restano sempre raggiungibili dal menu classico." />

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Ripristina impostazioni predefinite"
                        Padding="12,5" Click="Reset_Click"
                        ToolTip="Rimette la barra multifunzione come era all'installazione" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="96" Padding="0,5" IsDefault="True" Click="Ok_Click" />
                    <Button Content="Annulla" Width="96" Padding="0,5" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Funzioni disponibili" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ListBox x:Name="AvailableList" BorderBrush="#DDDDDD"
                         MouseDoubleClick="Available_DoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,2"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InRibbonHint}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Style="{StaticResource SmallButton}" Content="Aggiungi &#x203A;&#x203A;" Click="Add_Click" />
                <Button Style="{StaticResource SmallButton}" Content="&#x2039;&#x2039; Rimuovi" Click="Remove_Click" />
            </StackPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Barra multifunzione" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TreeView x:Name="LayoutTree" BorderBrush="#DDDDDD"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItemChanged="LayoutTree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="10,22,0,0">
                <Button Style="{StaticResource SmallButton}" Content="Sposta su" Click="MoveUp_Click" />
                <Button Style="{StaticResource SmallButton}" Content="Sposta giù" Click="MoveDown_Click" />
                <Separator Margin="0,4,0,10" />
                <Button Style="{StaticResource SmallButton}" Content="Nuova scheda" Click="NewTab_Click" />
                <Button Style="{StaticResource SmallButton}" Content="Nuovo riquadro" Click="NewGroup_Click" />
                <Button Style="{StaticResource SmallButton}" Content="Rinomina" Click="Rename_Click" />
                <Separator Margin="0,4,0,10" />
                <CheckBox x:Name="LargeCheck" Content="Pulsante grande" IsEnabled="False"
                          Click="Large_Click" Margin="2,0,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
