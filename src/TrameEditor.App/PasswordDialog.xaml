<Window x:Class="TrameEditor.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <PasswordBox x:Name="PasswordInput" Padding="4,3" FontSize="13" />
        <TextBlock x:Name="ConfirmLabel" Text="Ripeti la password:" Margin="0,10,0,4" />
        <PasswordBox x:Name="ConfirmInput" Padding="4,3" FontSize="13" />
        <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="11" Margin="0,6,0,0"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Annulla" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
