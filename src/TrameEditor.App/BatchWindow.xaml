<Window x:Class="TrameEditor.App.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ricette — lavorare su molti file in una volta"
        Icon="Assets/icon-256.png"
        Width="680" Height="600" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Left" x:Name="PickFilesButton" Content="Scegli file…"
                        Padding="10,4" Click="PickFiles_Click" />
                <Button DockPanel.Dock="Left" Content="…o una cartella" Padding="10,4"
                        Margin="8,0,0,0" Click="PickInputFolder_Click" />
                <TextBlock x:Name="FilesText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="nessun file scelto" Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Left" Content="Cartella dei risultati…" Padding="10,4"
                        Click="PickFolder_Click" />
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="nessuna cartella scelta" Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <TabControl x:Name="ModeTabs" SelectionChanged="Mode_Changed" BorderBrush="#DDDDDD">
                <TabItem Header="Ricetta sui PDF">
                    <StackPanel Margin="10,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Applica gli stessi passi a molti PDF. Gli originali non vengono mai toccati: i risultati finiscono nella cartella scelta." />
                        <CheckBox x:Name="OcrCheck" Content="OCR — riconosci il testo delle pagine scansionate" Margin="0,2" />
                        <CheckBox x:Name="RedactCheck" Content="Anonimizza — rimuovi dati personali e metadati (automatico, senza conferme)" Margin="0,2" />
                        <CheckBox x:Name="CompressCheck" Content="Comprimi — riduci il peso delle immagini" Margin="0,2" />
                        <CheckBox x:Name="PdfACheck" Margin="0,2" Checked="PdfA_Changed" Unchecked="PdfA_Changed"
                                  Content="Converti in PDF/A — il formato dell'archiviazione a lungo termine" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="22,0,0,4"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Solo per via fedele: rasterizzare molti file senza guardarli, perdendo il testo, non è una cosa da fare in serie. I file che non si possono convertire così vengono elencati, da aprire uno per uno." />
                        <DockPanel Margin="0,2">
                            <CheckBox x:Name="ProtectCheck" Content="Proteggi con password:" VerticalAlignment="Center"
                                      Checked="Protect_Changed" Unchecked="Protect_Changed" />
                            <PasswordBox x:Name="ProtectPassword" Width="180" Margin="8,0,0,0" Padding="3,2"
                                         HorizontalAlignment="Left"
                                         IsEnabled="{Binding IsChecked, ElementName=ProtectCheck}" />
                        </DockPanel>
                        <TextBlock x:Name="ExclusionNote" TextWrapping="Wrap" FontSize="11" Margin="22,2,0,0"
                                   Visibility="Collapsed" Foreground="Firebrick"
                                   Text="PDF/A e password si escludono: un file cifrato non è un PDF/A. Scegline uno." />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Estrai da file firmati (.p7m)">
                    <StackPanel Margin="10,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMutedBrush}">
                            Metti in una cartella tutti i file firmati digitalmente e tirane fuori i documenti
                            veri, apribili con qualunque lettore. Per ogni file viene detto chi ha firmato e se
                            la firma è integra.
                        </TextBlock>
                        <CheckBox x:Name="RenderInvoicesCheck" IsChecked="True" Margin="0,2"
                                  Content="Se dentro c'è una fattura elettronica, salva anche la versione leggibile in PDF" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMutedBrush}">
                            Senza questa spunta otterresti l'XML della fattura, illeggibile esattamente come prima.
                        </TextBlock>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right" Content="Chiudi" Width="90" Padding="0,5" IsCancel="True" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Ferma" Width="90" Padding="0,5"
                    Margin="0,0,8,0" Click="Cancel_Click" IsEnabled="False" />
            <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Avvia" Width="110" Padding="0,5"
                    FontWeight="Bold" Margin="0,0,8,0" Click="Run_Click" />
        </DockPanel>

        <ListBox x:Name="ResultsList" Margin="0,10,0,0" FontSize="12"
                 BorderBrush="#DDDDDD" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
