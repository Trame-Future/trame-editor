<Window x:Class="TrameEditor.App.FolderSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerca in una cartella di PDF"
        Icon="Assets/icon-256.png"
        Width="760" Height="580" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Left" Content="Scegli cartella…" Padding="10,4"
                        Click="PickFolder_Click" />
                <CheckBox x:Name="SubfoldersCheck" DockPanel.Dock="Right" Content="anche nelle sottocartelle"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="nessuna cartella scelta" Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" x:Name="SearchButton" Content="Cerca" Width="100"
                        Padding="0,5" FontWeight="Bold" Margin="8,0,0,0" Click="Search_Click" />
                <TextBox x:Name="QueryBox" Padding="4,4" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="ApplicationCommands.NotACommand" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Scrivi una parola o un codice e scegli la cartella: cercheremo dentro tutti i PDF." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="11"
                       Foreground="Firebrick" MaxWidth="520" />
            <Button DockPanel.Dock="Right" Content="Chiudi" Width="90" Padding="0,5" IsCancel="True" />
        </DockPanel>

        <ListBox x:Name="ResultsList" Margin="0,6,0,0" FontSize="12" BorderBrush="#DDDDDD"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="Result_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding FileName, Mode=OneWay}" />
                            <Run Text=" — pag. " Foreground="{StaticResource TextMutedBrush}" />
                            <Run Text="{Binding PageNumber, Mode=OneWay}"
                                 Foreground="{StaticResource TextMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
