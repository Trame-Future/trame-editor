<Window x:Class="TrameEditor.App.DecorateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numeri di pagina, filigrana e intestazioni"
        Icon="Assets/icon-256.png"
        Width="560" Height="520" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Le scritte vengono sovrapposte al documento: il contenuto originale non viene toccato. Il risultato si salva in una copia." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Annulla" Width="90" Padding="0,5"
                    Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Applica…" Width="110" Padding="0,5"
                    FontWeight="Bold" IsDefault="True" Click="Apply_Click" />
        </DockPanel>

        <StackPanel>
            <CheckBox x:Name="NumberingCheck" IsChecked="True" FontWeight="SemiBold"
                      Content="Numeri di pagina" />
            <Grid Margin="22,6,0,12" IsEnabled="{Binding IsChecked, ElementName=NumberingCheck}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Formato:" VerticalAlignment="Center" Margin="0,3" />
                <TextBox x:Name="FormatBox" Grid.Column="1" Text="{}{n} / {tot}" Margin="8,3"
                         Padding="3,2" />
                <TextBlock Grid.Row="1" Text="Posizione:" VerticalAlignment="Center" Margin="0,3" />
                <ComboBox x:Name="PositionBox" Grid.Row="1" Grid.Column="1" Margin="8,3"
                          SelectedIndex="0">
                    <ComboBoxItem Content="In basso al centro" />
                    <ComboBoxItem Content="In basso a destra" />
                    <ComboBoxItem Content="In basso a sinistra" />
                    <ComboBoxItem Content="In alto al centro" />
                    <ComboBoxItem Content="In alto a destra" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="Comincia da:" VerticalAlignment="Center" Margin="0,3" />
                <TextBox x:Name="StartAtBox" Grid.Row="2" Grid.Column="1" Text="1" Width="60"
                         HorizontalAlignment="Left" Margin="8,3" Padding="3,2" />
                <CheckBox x:Name="SkipFirstCheck" Grid.Row="3" Grid.Column="1" Margin="8,4"
                          Content="Non numerare la prima pagina (copertina)" />
            </Grid>

            <CheckBox x:Name="WatermarkCheck" FontWeight="SemiBold" Content="Filigrana in diagonale" />
            <DockPanel Margin="22,6,0,12" IsEnabled="{Binding IsChecked, ElementName=WatermarkCheck}">
                <TextBlock DockPanel.Dock="Left" Text="Testo:" VerticalAlignment="Center" />
                <TextBox x:Name="WatermarkBox" Text="COPIA" Margin="8,0,0,0" Padding="3,2" />
            </DockPanel>

            <CheckBox x:Name="HeaderFooterCheck" FontWeight="SemiBold"
                      Content="Intestazione e piè di pagina" />
            <Grid Margin="22,6,0,0" IsEnabled="{Binding IsChecked, ElementName=HeaderFooterCheck}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="In alto:" VerticalAlignment="Center" Margin="0,3" />
                <TextBox x:Name="HeaderBox" Grid.Column="1" Margin="8,3" Padding="3,2" />
                <TextBlock Grid.Row="1" Text="In basso:" VerticalAlignment="Center" Margin="0,3" />
                <TextBox x:Name="FooterBox" Grid.Row="1" Grid.Column="1" Margin="8,3" Padding="3,2" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
