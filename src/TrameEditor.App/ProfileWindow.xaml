<Window x:Class="TrameEditor.App.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="I miei dati — Compila per me"
        Icon="Assets/icon-256.png"
        Width="480" Height="620" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <DockPanel Margin="18,14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12">
            Questi dati servono a "Compila per me" per riempire i moduli PDF al posto tuo.
            Restano <Bold>solo sul tuo computer</Bold>, cifrati con la protezione
            dell'account Windows. Compila solo i campi che vuoi usare.
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Salva" Width="100" Padding="0,5" FontWeight="Bold"
                    IsDefault="True" Click="Save_Click" />
            <Button Content="Annulla" Width="100" Padding="0,5" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FieldsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,6,9">
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
