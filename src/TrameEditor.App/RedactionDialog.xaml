<Window x:Class="TrameEditor.App.RedactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anonimizza documento"
        Width="560" Height="500" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            Questi dati personali sono stati riconosciuti nel documento.
            I dati selezionati verranno <Bold>rimossi davvero</Bold> dal file
            (sostituiti da "X") — non semplicemente coperti.
            Deseleziona gli eventuali falsi positivi.
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="StripMetadataCheck" IsChecked="True"
                      Content="Rimuovi anche i metadati (autore, titolo, applicazione)" />
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <TextBlock x:Name="CountText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                <Button DockPanel.Dock="Right" Content="Annulla" Width="90" Padding="0,5"
                        Margin="8,0,0,0" IsCancel="True" />
                <Button DockPanel.Dock="Right" Content="Anonimizza" Width="110" Padding="0,5"
                        FontWeight="Bold" IsDefault="True" Click="Apply_Click" />
            </DockPanel>
        </StackPanel>
        <ListBox x:Name="ItemsList" BorderBrush="#DDDDDD">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="2,3">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="{Binding KindName, Mode=OneWay}" />
                            <Run Text="{Binding Value, Mode=OneWay}" />
                            <Run Foreground="Gray" Text="{Binding PageInfo, Mode=OneWay}" />
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
