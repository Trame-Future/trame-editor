<Window x:Class="TrameEditor.App.SignaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firme digitali"
        Icon="Assets/icon-256.png"
        Width="640" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" TextWrapping="Wrap"
                   FontWeight="SemiBold" Margin="0,0,0,8" />

        <Border DockPanel.Dock="Bottom" Background="#F6F6F4" CornerRadius="4"
                Padding="10,8" Margin="0,10,0,0">
            <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Border>
        <Button DockPanel.Dock="Bottom" Content="Chiudi" Width="90" Padding="0,5"
                HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True" />

        <ListBox x:Name="SignatureList" BorderBrush="#DDDDDD"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2,4" Padding="10,8" CornerRadius="6" Background="#FAFAF8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}"
                                           FontSize="18" Margin="0,0,10,0"
                                           VerticalAlignment="Top"
                                           Foreground="{Binding Accent}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding SignerName}" FontWeight="Bold" FontSize="14"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Verdict}" Foreground="{Binding Accent}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Details}" Margin="28,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   FontSize="12" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
