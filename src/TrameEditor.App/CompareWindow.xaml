<Window x:Class="TrameEditor.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confronta PDF"
        Icon="Assets/icon-256.png"
        Width="860" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <DockPanel Margin="14,10">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap"
                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right" Content="Chiudi" Width="90" Padding="0,5" IsCancel="True" />
            <Button x:Name="ReportButton" DockPanel.Dock="Right" Content="Salva rapporto HTML…"
                    Padding="10,5" Margin="0,0,8,0" Click="SaveReport_Click" IsEnabled="False" />
        </DockPanel>
        <ListBox x:Name="DiffList" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 BorderBrush="#DDDDDD" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Pages}" Margin="10,0,0,0"
                                   Foreground="Gray" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Display}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                                            <Setter Property="Foreground" Value="#1B7A2F" />
                                            <Setter Property="Background" Value="#E7F6EA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                            <Setter Property="Foreground" Value="#B02A22" />
                                            <Setter Property="Background" Value="#FBEAE8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Gap">
                                            <Setter Property="Foreground" Value="#9A9A9A" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
