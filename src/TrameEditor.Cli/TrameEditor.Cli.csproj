<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Il comando che si digita (e che un agente lancia). NON può chiamarsi "trameeditor":
         Windows non distingue le maiuscole nei nomi di file, e nella cartella di installazione
         andrebbe a sovrascrivere TrameEditor.exe, cioè l'applicazione. -->
    <AssemblyName>trameeditor-cli</AssemblyName>
    <RootNamespace>TrameEditor.Cli</RootNamespace>
    <Version>2.14.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrameEditor.Core\TrameEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
